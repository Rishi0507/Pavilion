# Raw Cricsheet downloads. Fetched with `make data`, never committed:
# large, redistributable only with attribution, and reproducible.
/data/raw/

# Generated corpus and fitted rate table. Build artifacts.
/data/out/*.bin

# Cached HTTP responses from the attribute pipeline. Regenerable, and large.
/data/raw/wpcache/

# Exported training matrices. Regenerable from the corpus.
/data/out/*.csv

# The results database. Local play data, not source.
/data/out/*.db
/data/out/*.db-shm
/data/out/*.db-wal

# The LightGBM text model is four megabytes of trees; the metadata, the
# parity fixtures and the reliability plots are small and are committed,
# because they are the evidence that the model is calibrated and that Go
# and Python agree.
/data/models/outcome.txt
/data/models/winprob.txt

# Go build output.
/bin/
*.exe
*.test
*.out

# Python
__pycache__/
*.py[cod]
.venv/
ml/.venv/

# Editor and OS
.DS_Store
.idea/
.vscode/

# Local configuration. The server reads its master secret from the
# environment, and that secret must never be committed: with it, every ball
# of every day could be computed before a single decision was made.
.env
.env.local
.env.*.local
