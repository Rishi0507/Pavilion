# Pavilion configuration.
#
# Copy this file to .env and fill in a real secret before running anything
# that other people can reach. Load it into your shell however you prefer;
# the server reads plain environment variables and does not parse .env
# itself.

# The master secret. Every day's deliveries are derived from it, so a
# published or guessable value makes the whole game solvable offline: with
# the secret and the model, a client could compute every ball before making
# a single decision.
#
# Generate one with:
#   openssl rand -hex 32
#
# Leaving it unset starts the server with a development default and logs a
# warning. That is fine on a laptop and unacceptable anywhere else.
PAVILION_SECRET=

# Listen address for the server. Defaults to 127.0.0.1:8080.
PAVILION_ADDR=127.0.0.1:8080
